     private val topLevelClassesCache: MutableMap<FqName, SmartList<VirtualFile>?> = Object2ObjectOpenHashMap()
 
+    /**
+     * Caches the class names that JAR and JRT roots contribute to [knownClassNamesInPackage], per package.
+     *
+     * The result does not depend on any scope, but every Analysis API library session asks for it through its own
+     * `FirJavaFacade` and caches what it gets. Without this cache each session holds its own copy of the same names, so memory
+     * grows with library sessions times packages resolved. Archive contents are read once by their file systems, so caching
+     * them adds no staleness; directory roots can gain files (sources, or classes written by a build), so their names are still
+     * collected on every call. Roots added to the index after [initialize] are not seen for packages already cached.
+     */
+    private val archiveClassNamesCache = ConcurrentHashMap<FqName, Set<String>>()
+
     private val allScope = GlobalSearchScope.allScope(myPsiManager.project)
     private var usePsiClassFilesReading = false
 
@@ -83,6 +97,7 @@ class KotlinCliJavaFileManagerImpl(private val myPsiManager: PsiManager) : CoreJ
         this.singleJavaFileRootsIndex = singleJavaFileRootsIndex
         this.usePsiClassFilesReading = usePsiClassFilesReading
         this.perfManager = perfManager
+        archiveClassNamesCache.clear()
     }
 
     private fun findPsiClass(classId: ClassId, searchScope: GlobalSearchScope): PsiClass? {
@@ -290,23 +305,49 @@ class KotlinCliJavaFileManagerImpl(private val myPsiManager: PsiManager) : CoreJ
     }
 
     override fun knownClassNamesInPackage(packageFqName: FqName): Set<String> {
+        val archiveNames = archiveClassNamesCache.computeIfAbsent(packageFqName) {
+            Collections.unmodifiableSet(collectClassNames(it) { dir, rootType -> rootType == JavaRoot.RootType.BINARY && dir.isInArchive })
+        }
+
+        val liveNames = collectClassNames(packageFqName) { dir, rootType -> rootType != JavaRoot.RootType.BINARY || !dir.isInArchive }
+        for (classId in singleJavaFileRootsIndex.findJavaSourceClasses(packageFqName)) {
+            assert(!classId.isNestedClass) { "ClassId of a single .java source class should not be nested: $classId" }
+            liveNames.add(classId.shortClassName.asString())
+        }
+
+        return if (liveNames.isEmpty()) archiveNames else UnionSet(archiveNames, liveNames)
+    }
+
+    private val VirtualFile.isInArchive: Boolean
+        get() = fileSystem.protocol.let { it == StandardFileSystems.JAR_PROTOCOL || it == StandardFileSystems.JRT_PROTOCOL }
+
+    private fun collectClassNames(
+        packageFqName: FqName,
+        acceptDirectory: (VirtualFile, JavaRoot.RootType) -> Boolean,
+    ): MutableSet<String> {
         val result = ObjectOpenHashSet<String>()
-        index.traverseDirectoriesInPackage(packageFqName, continueSearch = { dir, _ ->
-            for (child in dir.children) {
-                if (child.extension == "class" || child.extension == "java" || child.extension == "sig") {
-                    result.add(child.nameWithoutExtension)
+        index.traverseDirectoriesInPackage(packageFqName, continueSearch = { dir, rootType ->
+            if (acceptDirectory(dir, rootType)) {
+                for (child in dir.children) {
+                    if (child.extension == "class" || child.extension == "java" || child.extension == "sig") {
+                        result.add(child.nameWithoutExtension)
+                    }
                 }
             }
 
             true
         })
+        return result
+    }
 
-        for (classId in singleJavaFileRootsIndex.findJavaSourceClasses(packageFqName)) {
-            assert(!classId.isNestedClass) { "ClassId of a single .java source class should not be nested: $classId" }
-            result.add(classId.shortClassName.asString())
-        }
+    /** A read-only view of two sets that keeps the shared [first] set instead of copying it. */
+    private class UnionSet(private val first: Set<String>, private val second: Set<String>) : AbstractSet<String>() {
+        override val size: Int
+            get() = first.size + second.count { it !in first }
 
-        return result
+        override fun contains(element: String): Boolean = element in first || element in second
+
+        override fun iterator(): Iterator<String> = (first.asSequence() + second.asSequence().filter { it !in first }).iterator()
     }
 
